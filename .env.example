# ---- OpenAI (used from Phase 3 onward; leave blank for Phase 1) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium

# ---- TallyPrime XML/TDL HTTP interface ----
TALLY_URL=http://127.0.0.1:9000
TALLY_COMPANY=Creaitify Pvt Ltd
# Your own GSTIN. Optional, but it lets an uploaded invoice be classified
# as a purchase or a sale automatically.
TALLY_COMPANY_GSTIN=27AABCT1332L1ZE
TALLY_TIMEOUT_MS=30000

# ---- Local app server (used from Phase 2 onward) ----
APP_HOST=127.0.0.1
APP_PORT=3210
# Leave empty to keep the server on localhost only. Set a generated token
# (npm run token) to allow binding to a network address; every request must
# then send "Authorization: Bearer <token>".
APP_AUTH_TOKEN=
